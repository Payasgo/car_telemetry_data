# LOCAL WINDOWS LAPTOP — SQL Server / Windows Authentication
SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=TaigunTelemetry;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes

UDP_HOST=0.0.0.0
UDP_PORT=5005
OBD_PORT=

# OPTIONAL SECURE CLOUD SYNC — local laptop ONLY.
# Supabase project URL, service_role secret, and Auth user's UUID.
# Never commit .env or copy the service-role key into Streamlit Cloud or ESP32.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_OWNER_ID=
CLOUD_BATCH_SIZE=100
CLOUD_POLL_SECONDS=5
