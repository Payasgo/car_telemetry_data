# SQL Server Standard/Enterprise, Windows 10, Windows Authentication.
# Replace SERVER with HOST\INSTANCE (or hostname,port for a fixed TCP port).
# ODBC Driver 18 should be installed on this Windows 10 laptop.
SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=TaigunTelemetry;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes

UDP_HOST=0.0.0.0
UDP_PORT=5005
# Leave empty for python-OBD auto-detection; examples: COM5
OBD_PORT=

# Optional cloud sync; leave blank to disable.
SUPABASE_URL=
SUPABASE_KEY=
CLOUD_BATCH_SIZE=100
CLOUD_POLL_SECONDS=5
